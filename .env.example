# کلید OpenRouter برای مسیر هوشمند (توضیحات/آنالیز سایت).
# بدون این کلید هم برنامه کار می‌کند و از موتور الگوریتمی استفاده می‌شود.
OPENROUTER_API_KEY=

# مدل پیش‌فرض؛ در صورت نیاز عوض کن (مثلاً یک مدل رایگان):
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=google/gemini-2.5-flash
